<mvc:View controllerName="code.program01.controller.Main"
    xmlns:core = "sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f = "sap.ui.layout.form"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
    <!-- [1. 조회조건 Panel] -->
    <!-- 주문 정보를 검색하기 위한 조건들을 입력하는 영역 -->
        <Panel id="idPanel" headerText="조회조건" expanded="true" expandable="false" width="100%">
            <content>
                <VBox id="idVBox">
                <!-- [1-1. 첫 번째 조회조건 영역] -->
            <!-- 주문날짜, 주문번호, 고객명, 담당 직원으로 검색 -->

                <HBox id="idHBox" alignItems="Center">
                    <Label id="lblDate" text="주문날짜" > </Label>
                    <DateRangeSelection id="idDate" displayFormat="yyyy-MM-dd" valueFormat="yyyy-MM-dd" 
                                        width="14rem" class="sapUiSmallMarginBegin"></DateRangeSelection>
                    
                    <Label id="lblOrderID" text="OrderID" class="sapUiSmallMarginBegin"></Label>
                    <Input id="inp1" placeholder="주문번호 입력" type="Number" class="sapUiSmallMarginBegin" width="8rem"></Input>
                    
                    <Button id="btn1" text="조회" icon="sap-icon://search" press=".onSearch" class="sapUiSmallMarginBegin" ></Button>
                    
                    <Label id="lblCust" text="고객명" class="sapUiSmallMarginBegin"></Label>
                    <ComboBox id="comboCust" placeholder="고객 선택" items="{/Customers}" selectionChange=".onSelectionChange" class="sapUiSmallMarginBegin">
                        <core:Item id="coreItem" key="{CustomerID}" text="{CompanyName}"></core:Item>
                    </ComboBox>
                    
                    <Label id="lblEmp" text="담당 직원" class="sapUiSmallMarginBegin"></Label>
                    <ComboBox id="comboEmp" placeholder="직원 선택" items="{/Employees}" selectionChange=".onSelectionChange" class="sapUiSmallMarginBegin">
                        <core:Item id="coreItem2" key="{EmployeeID}" text="{FirstName} {LastName}"></core:Item>
                    </ComboBox>              
                </HBox>
                 <!-- [1-2. 두 번째 조회조건 영역] -->
            <!-- 배송사, 배송 상태, 카테고리, 상품명으로 검색 -->

                <HBox id="idHBox2" alignItems="Center">
                    <Label id="lblShip" text="배송사" class="sapUiSmallMarginBegin"></Label>
                    <ComboBox id="comboShip" placeholder="배송사 선택" items="{/Shippers}" selectionChange=".onSelectionChange" class="sapUiSmallMarginBegin">
                        <core:Item id="coreItem3" key="{ShipperID}" text="{CompanyName}"></core:Item>
                    </ComboBox>   
                    <Label id="lblCntr" text="배송 상태" class="sapUiSmallMarginBegin"></Label>
                    <ComboBox id="comboStat" placeholder="배송 상태 선택" selectionChange=".onSelectionChange" class="sapUiSmallMarginBegin">
                        <core:Item id="st0" key="" text="전체"/>
                        <core:Item id="st1" key="Y" text="배송완료"/>
                        <core:Item id="st2" key="N" text="미배송"/>
                    </ComboBox>
                    <Label id="lblCtgr" text="카테고리" class="sapUiSmallMarginBegin"></Label>
                    <ComboBox id="comboCtgr" placeholder="카테고리 선택" items="{/Categories}" selectionChange=".onCategoryChange"
                                class="sapUiSmallMarginBegin">
                        <core:Item id="coreItem4" key="{CategoryID}" text="{CategoryName}"></core:Item>
                    </ComboBox>
                    <Label id="lblProd" text="상품명" class="sapUiSmallMarginBegin"></Label>
                    <ComboBox id="comboProd" placeholder="상품 선택" items="{/Products}" selectionChange=".onSelectionChange" class="sapUiSmallMarginBegin">
                        <core:Item id="coreItem5" key="{ProductID}" text="{ProductName}"></core:Item>
                    </ComboBox>
                </HBox>
                </VBox>
                <!-- [1-3. 초기화 버튼] -->
                <!-- 입력하거나 선택한 조회조건을 초기 상태로 되돌림 -->
                <!-- Controller의 onReset 함수 실행 -->

                <Button id="btnReset" text="초기화" icon="sap-icon://reset" press=".onReset" class="sapUiSmallMarginBegin"></Button>
            
            </content>
        </Panel>

        <!-- [2. 주문 정보 Table] -->
        <!-- 조회조건에 해당하는 주문 데이터를 테이블 형태로 출력하는 영역 -->

        <Table id="idTable1"  items="{path: '/Orders', parameters: {expand: 'Shipper,Order_Details'}}" visible="false" headerText="주문 정보" selectionChange=".onSelectionChange">
            <columns>
                <Column id="idCol1">
                    <Text id="txt1" text="고객명"></Text>
                </Column>
                <Column id="idCol2">
                    <Text id="txt2" text="주문번호"></Text>
                </Column>
                <Column id="idCol3">
                    <Text id="txt3" text="RequiredDate"></Text>
                </Column>
                <Column id="idCol4">
                    <Text id="txt4" text="ShippedDate"></Text>
                </Column>
                <Column id="idCol5">
                    <Text id="txt5" text="주문 날짜"></Text>
                </Column>
                <Column id="idCol6">
                    <Text id="txt6" text="운임"></Text>
                </Column>
                <Column id="idCol7">
                    <Text id="txt7" text="배송사"></Text>
                </Column>
                <Column id="idCol8">
                    <Text id="txt8" text="배송상태"></Text>
                </Column>
                <Column id="idCol9">
                    <Text id="txt9" text="금액"></Text>
                </Column>
                <Column id="idCol10">
                    <Text id="txt10" text="상품수"></Text>
                </Column>
                <!-- 주문별 상세정보를 확인하기 위한 Detail 버튼 열 -->
                <Column id="idCol11">
                    <Text id="txt21" text="Detail"></Text>
                </Column>

            </columns>
            <!-- [2-2. items 영역] -->
            <!-- 주문 데이터를 실제 테이블 행으로 출력하는 영역 -->
            <!-- 각 주문의 정보를 바인딩하여 표시 -->

            <items>
                <ColumnListItem id="idCol">
                    <cells>
                        <Text id="txt11" text="{CustomerID}"></Text>
                        <Text id="txt12" text="{OrderID}"></Text>
                        <!-- 배송 요청일 표시 (날짜 형식 변환) -->
                        <Text id="txt13" text="{path: 'RequiredDate', type: 'sap.ui.model.type.Date', formatOptions: {pattern: 'yyyy-MM-dd', UTC: true}}"></Text>
                        <!-- 실제 배송일 표시 (날짜 형식 변환) -->
                        <Text id="txt14" text="{path: 'ShippedDate', type: 'sap.ui.model.type.Date', formatOptions: {pattern: 'yyyy-MM-dd', UTC: true}}"></Text>
                        <!-- 주문일 표시 (날짜 형식 변환) -->
                        <Text id="txt15" text="{path: 'OrderDate', type: 'sap.ui.model.type.Date', formatOptions: {pattern: 'yyyy-MM-dd', UTC: true}}"></Text>
                        <Text id="txt16" text="{Freight}"></Text>
                        <Text id="txt17" text="{ShipName}"></Text>
                        <!-- 배송일을 기준으로 배송 상태 표시 -->
                        <!-- formatter의 deliveryStatus 함수 실행 -->
                        <Text id="txt18" text="{path: 'ShippedDate', formatter: '.formatter.deliveryStatus'}"></Text>
                         <!-- 주문 상세정보를 기준으로 총 주문 금액 계산 -->
                        <!-- formatter의 calcAmount 함수 실행 -->
                        <Text id="txt19" text="{path: 'Order_Details', formatter: '.formatter.calcAmount'}"></Text>
                        <!-- 주문 상세정보를 기준으로 상품 개수 계산 -->
                        <!-- formatter의 calcCount 함수 실행 -->
                        <Text id="txt20" text="{path: 'Order_Details', formatter: '.formatter.calcCount'}"></Text>
                        <Button id="btnDetail" text="Detail" press=".onDetail"></Button>
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    
    </Page>
</mvc:View>